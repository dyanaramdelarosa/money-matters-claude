# Copy to .env and fill in real values. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Omit for a quick local run (falls back to sqlite:///db.sqlite3).
# Required in prod.py; set to point at the Postgres service in Docker Compose.
# DATABASE_URL=postgres://moneymatters:moneymatters@db:5432/moneymatters
